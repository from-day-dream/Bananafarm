# Dockerfile for building Banana Farm Linux packages
# This image includes Flutter SDK and all necessary build tools for creating DEB and AppImage packages

FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set environment variables
ENV FLUTTER_HOME=/opt/flutter
ENV PATH="$FLUTTER_HOME/bin:$PATH"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libstdc++-12-dev \
    libayatana-appindicator3-dev \
    # Additional dependencies for package building
    dpkg-dev \
    fakeroot \
    rpm \
    patchelf \
    file \
    desktop-file-utils \
    libgdk-pixbuf2.0-dev \
    # For AppImage creation
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Flutter SDK (stable channel - latest version)
RUN git clone --depth 1 --branch stable https://github.com/flutter/flutter.git ${FLUTTER_HOME}

# Pre-download Flutter dependencies
RUN flutter precache --linux

# Enable Linux desktop support
RUN flutter config --enable-linux-desktop

# Install flutter_distributor globally
RUN flutter pub global activate flutter_distributor

# Add flutter pub global bin to PATH
ENV PATH="$PATH:/root/.pub-cache/bin"

# Set working directory
WORKDIR /workspace

# Verify installations
RUN flutter doctor -v && \
    flutter_distributor --version

# Default command shows help
CMD ["flutter_distributor", "--help"]
