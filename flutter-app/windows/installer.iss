; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Banana Farm"
#define MyAppVersion "0.1.0"
#define MyAppPublisher "day-dream"
#define MyAppURL "https://bananafarm.app"
#define MyAppExeName "BananaFarm.exe"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".bananafarm"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{8A8F27D8-4C8E-4E5F-9D1B-2A3B4C5D6E7F}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\day-dream\{#MyAppName}
DirExistsWarning=no
UsePreviousAppDir=no
ChangesAssociations=yes
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
PrivilegesRequired=admin
OutputDir=..\build\windows\installer
OutputBaseFilename=BananaFarm_Setup
UninstallDisplayIcon={app}\{#MyAppExeName}
SetupIconFile=runner\resources\app_icon.ico
WizardImageFile=runner\resources\wizard_image.bmp
WizardSmallImageFile=runner\resources\wizard_small.bmp
Compression=lzma
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Dirs]
; STRICTLY PRESERVE PARENT: "day-dream" folder will NEVER be deleted (empty or not).
; This ensures other day-dream apps remain safe.
Name: "{autopf}\day-dream"; Flags: uninsneveruninstall

[Files]
; IMPORTANT: Ensure you have built the app in Release mode first! (flutter build windows --release)
Source: "..\build\windows\x64\runner\Release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\build\windows\x64\runner\Release\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[UninstallDelete]
Type: filesandordirs; Name: "{app}"

[Registry]
; Deep Link / Protocol Registration
; Registers "app.bananafarm.desktop://" protocol
Root: HKCU; Subkey: "Software\Classes\app.bananafarm.desktop"; ValueType: string; ValueName: ""; ValueData: "URL:BananaFarm Protocol"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\app.bananafarm.desktop"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\app.bananafarm.desktop\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"
Root: HKCU; Subkey: "Software\Classes\app.bananafarm.desktop\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""

[Icons]
; AppUserModelID is what makes toast notifications work for an unpackaged
; Win32 app: Windows resolves a toast's identity from the Start Menu shortcut,
; so without this line notifications silently never appear. It must match
; _appUserModelId in lib/services/notification_service.dart. (The MSIX build
; does not need it — package identity supplies its own AUMID.)
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; AppUserModelID: "app.bananafarm.desktop"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; AppUserModelID: "app.bananafarm.desktop"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
